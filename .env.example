# ============================================================
# DandoEv Backend — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in ALL values before running.
# NEVER commit .env.local to version control.

# ---- Database (PostgreSQL) ----
# Get from: Supabase > Settings > Database > Connection string (Direct)
# Or use Railway: railway add PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/dandoev?schema=public"

# ---- Redis (Required for BullMQ job queues) ----
# Options: Upstash (serverless, free tier), Railway (addons), or self-hosted
# Upstash: https://upstash.com → Create Redis → Copy REST URL (use ioredis format)
REDIS_URL="redis://localhost:6379"
# For Upstash TLS:
# REDIS_URL="rediss://:password@xxx.upstash.io:6380"

# ---- Authentication (Supabase) ----
# Get from: Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- JWT (Standalone fallback — NOT used when Supabase is active) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_64_char_random_hex_access_secret"
JWT_REFRESH_SECRET="CHANGE_ME_64_char_random_hex_refresh_secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ---- Payment Gateway (Paystack) ----
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_live_xxxxx"
PAYSTACK_PUBLIC_KEY="pk_live_xxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_xxxxx"
# HMAC secret for webhook signature verification
PAYSTACK_WEBHOOK_SECRET="your-paystack-webhook-secret"

# ---- Mono (Open Banking — Bank Statements & Account Linking) ----
# Get from: https://app.mono.co → Apps → API Keys
MONO_SECRET_KEY="live_sk_xxxxxxxxxx"
MONO_WEBHOOK_SECRET="your-mono-webhook-secret"
NEXT_PUBLIC_MONO_PUBLIC_KEY="live_pk_xxxxxxxxxx"

# ---- File Storage (Supabase Storage) ----
# Supabase Storage is configured above via SUPABASE vars.
# Create a bucket named 'dandoev-docs' in Supabase > Storage.
# Optional: Also configure Cloudinary as fallback
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Email Service (Resend) ----
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxx"
# Must be a verified sender domain in Resend
RESEND_FROM_EMAIL="notifications@dandoev.com"

# ---- SMS / WhatsApp (Termii) ----
# Get from: https://termii.com → Settings → API Keys
TERMII_API_KEY="TLxxxxxxxxxxx"
# Approved alphanumeric sender ID registered with Termii
TERMII_SENDER_ID="DandoEv"

# ---- Sentry (Error Monitoring) ----
# Get from: https://sentry.io → Settings → Projects → Client Keys (DSN)
SENTRY_DSN="https://xxxxx@oxxxx.ingest.sentry.io/xxxxxx"
SENTRY_ORG="dandoev"
SENTRY_PROJECT="dandoev-web"
# Only needed for CI/CD source map uploads
SENTRY_AUTH_TOKEN=""

# ---- Application ----
NEXT_PUBLIC_APP_URL="https://dandoev.com"
NODE_ENV="production"
