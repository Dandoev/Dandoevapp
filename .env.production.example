# ==============================================================================
# DandoEv Platform — Production Environment Variables Configuration (.env.production)
# ==============================================================================
# INSTRUCTIONS:
# 1. Use this template to configure your Production Hosting Provider (Vercel, Railway, AWS, Docker).
# 2. Never commit actual production secrets to version control.
# 3. Ensure all secrets are 64-character cryptographically random strings where indicated.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV="production"
# The canonical domain of the production web application (without trailing slash)
NEXT_PUBLIC_APP_URL="https://dashboard.dandoev.com"

# ------------------------------------------------------------------------------
# 2. RELATIONAL DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL with SSL enabled (e.g. Supabase, Neon, AWS RDS, Railway)
# For Supabase: Project Settings -> Database -> Connection String (URI, Connection Pooling recommended: port 6543 or direct: 5432)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?schema=public&sslmode=require"

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED CACHE & BULLMQ BACKGROUND JOBS (Redis)
# ------------------------------------------------------------------------------
# Redis instance used by BullMQ for background job queuing (daily sweeps, mandate charges)
# Upstash Redis (Recommended for serverless): rediss://default:[PASSWORD]@[HOST].upstash.io:6379
REDIS_URL="rediss://default:[YOUR_REDIS_PASSWORD]@[YOUR_REDIS_HOST]:6379"

# ------------------------------------------------------------------------------
# 4. SUPABASE AUTHENTICATION & DOCUMENT STORAGE
# ------------------------------------------------------------------------------
# Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# CRITICAL: Service Role Key bypasses Row Level Security (RLS) for backend tasks
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 5. DATA ENCRYPTION & DATA PROTECTION (PII Compliance)
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used by src/lib/encryption.ts for AES-256-GCM encryption of customer BVN, NIN, and account numbers in DB
FIELD_ENCRYPTION_KEY="[GENERATE_64_CHAR_HEX_KEY]"

# Salt key for HMAC-SHA256 blind indexing (allows querying encrypted identity fields without decrypting)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BLIND_INDEX_KEY="[GENERATE_64_CHAR_HEX_KEY]"

# Fallback JWT secrets for standalone token signing
JWT_ACCESS_SECRET="[GENERATE_64_CHAR_HEX_KEY]"
JWT_REFRESH_SECRET="[GENERATE_64_CHAR_HEX_KEY]"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ------------------------------------------------------------------------------
# 6. MONO DIRECTPAY & OPEN BANKING GATEWAY
# ------------------------------------------------------------------------------
# Dashboard: https://app.withmono.com -> Apps -> Keys & Webhooks
# Primary payment channel for: Outright Bike Purchases, Accessories, Down Payments, Top-Ups & Mandates
MONO_SECRET_KEY="live_sk_[YOUR_LIVE_MONO_SECRET_KEY]"
NEXT_PUBLIC_MONO_PUBLIC_KEY="live_pk_[YOUR_LIVE_MONO_PUBLIC_KEY]"

# Secret key configured in Mono Dashboard Webhook settings to verify HMAC-SHA512 signatures
# Webhook URL in Mono Dashboard: https://dandoev.com/api/webhooks/mono
MONO_WEBHOOK_SECRET="[YOUR_LIVE_MONO_WEBHOOK_SIGNING_SECRET]"

# ------------------------------------------------------------------------------
# 7. AUTOMATED BACKGROUND REPAYMENT & SAVINGS SWEEPS
# ------------------------------------------------------------------------------
# Secret token protecting /api/admin/system/cron against unauthorized public execution
# External cron service (Vercel Cron / GitHub Actions / Cron-Job.org) must pass header:
# "Authorization: Bearer [CRON_SECRET]"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="[GENERATE_64_CHAR_HEX_KEY]"

# ------------------------------------------------------------------------------
# 8. SECONDARY / FALLBACK PAYMENT GATEWAY (Paystack)
# ------------------------------------------------------------------------------
# Dashboard: https://dashboard.paystack.com -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY="sk_live_[YOUR_PAYSTACK_SECRET]"
PAYSTACK_PUBLIC_KEY="pk_live_[YOUR_PAYSTACK_PUBLIC]"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_[YOUR_PAYSTACK_PUBLIC]"
PAYSTACK_WEBHOOK_SECRET="[YOUR_PAYSTACK_WEBHOOK_SECRET]"

# ------------------------------------------------------------------------------
# 9. COMMUNICATIONS & NOTIFICATIONS
# ------------------------------------------------------------------------------
# Resend Email Delivery: https://resend.com
RESEND_API_KEY="re_[YOUR_LIVE_RESEND_KEY]"
RESEND_FROM_EMAIL="support@dandoev.com"

# Termii SMS & WhatsApp Gateway: https://termii.com
TERMII_API_KEY="TL[YOUR_TERMII_API_KEY]"
TERMII_SENDER_ID="DandoEv"

# ------------------------------------------------------------------------------
# 10. ERROR MONITORING & PERFORMANCE (Sentry)
# ------------------------------------------------------------------------------
SENTRY_DSN="https://[PUBLIC_KEY]@[ORGANIZATION].ingest.sentry.io/[PROJECT_ID]"
SENTRY_ORG="dandoev"
SENTRY_PROJECT="dandoev-platform"
