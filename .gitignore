# DandoEv — Git Ignore
# ===================================================

# ---- Environment Variables ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ---- Node ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Next.js ----
.next/
out/
.vercel/

# ---- Build Output ----
build/
dist/

# ---- Prisma ----
# Generated client — regenerated on build
prisma/generated/

# ---- Database ----
*.db
*.sqlite
*.sql

# ---- Logs ----
logs/
*.log
scratch/

# ---- Editor / OS ----
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.swp
*.swo

# ---- Sensitive Files ----
*.pem
*.key
*.p12
*.pfx
SECRETS.md
CREDENTIALS.md

# ---- Cache ----
.turbo/
.cache/
.eslintcache

# ---- Sentry ----
.sentryclirc

# ---- TypeScript ----
*.tsbuildinfo

# ---- Coverage ----
coverage/
.nyc_output/
playwright-report/
test-results/

# ---- Mobile (if applicable) ----
ebike-mobile/node_modules/
ebike-mobile/.expo/
ebike-mobile/android/.gradle/
ebike-mobile/ios/Pods/
