{
  "info": {
    "name": "DandoEv Production API Collection",
    "description": "Complete Postman collection for DandoEv BNPL Marketplace, Mono Open Banking, Security & Compliance APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://dandoev.com/api" },
    { "key": "authToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth & Security",
      "item": [
        {
          "name": "Sign In",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/signin",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"solomon.dunu@demo.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Setup MFA (TOTP)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/mfa/setup",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        },
        {
          "name": "Verify MFA Code",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/mfa/verify",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"123456\",\n  \"secret\": \"JBSWY3DPEHPK3PXP\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Mono Open Banking & KYC",
      "item": [
        {
          "name": "Verify Mono KYC & Statement",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/kyc/mono",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"mono_auth_code_xyz\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "BNPL Loans & Repayments",
      "item": [
        {
          "name": "Submit BNPL Loan Application",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/loans",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bikeId\": \"seed-bike-G90\",\n  \"loanAmount\": 1485000,\n  \"downPayment\": 165000,\n  \"tenure\": 12,\n  \"interestRate\": 4.0,\n  \"monthlyRepayment\": 148500,\n  \"totalRepayable\": 1782000,\n  \"deliveryAddress\": \"12 Admiralty Way\",\n  \"deliveryCity\": \"Lagos\",\n  \"deliveryState\": \"Lagos\"\n}"
            }
          }
        },
        {
          "name": "List User Loans",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/loans",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Regulatory Compliance (NDPR / GDPR)",
      "item": [
        {
          "name": "Export User Data (NDPR Right to Access)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/user/compliance",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        },
        {
          "name": "Request Account Erasure (Right to be Forgotten)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/user/compliance",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"REQUEST_ERASURE\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin Operations & Fraud Console",
      "item": [
        {
          "name": "Get Fraud & Anomaly Logs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/fraud",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        },
        {
          "name": "Get Compliance Audit Records",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/compliance",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        }
      ]
    }
  ]
}
