{
  "expo": {
    "name": "DandoEv",
    "slug": "ebike",
    "scheme": "dandoev",
    "version": "1.0.22",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A154F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dandoev.mobile",
      "buildNumber": "38",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "DandoEv requires camera access to capture KYC identity documents and selfie verification.",
        "NSPhotoLibraryUsageDescription": "DandoEv requires photo library access to upload identity and utility documents."
      }
    },
    "android": {
      "package": "com.dandoev.mobile",
      "versionCode": 35,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "dandoev",
              "host": "payment-callback"
            },
            {
              "scheme": "dandoev",
              "host": "mono-connect-callback"
            },
            {
              "scheme": "dandoev",
              "host": "kyc-callback"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "DandoEv - Commercial E-Bike Mobility & BNPL",
      "shortName": "DandoEv",
      "display": "standalone",
      "backgroundColor": "#0A154F",
      "themeColor": "#2E3192",
      "orientation": "portrait"
    },
    "extra": {
      "eas": {
        "projectId": "a162b251-8724-4c20-ba36-ce727a0d06bc"
      }
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-notifications"
    ],
    "owner": "dandoev-bike"
  }
}
