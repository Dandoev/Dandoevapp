{
  "expo": {
    "name": "DandoEv",
    "slug": "dandoev",
    "scheme": "dandoev",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A154F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dandoev.mobile",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "DandoEv requires camera access to capture KYC identity documents and selfie verification.",
        "NSPhotoLibraryUsageDescription": "DandoEv requires photo library access to upload identity and utility documents."
      }
    },
    "android": {
      "package": "com.dandoev.mobile",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "DandoEv - Commercial E-Bike Mobility & BNPL",
      "shortName": "DandoEv",
      "display": "standalone",
      "backgroundColor": "#0A154F",
      "themeColor": "#2E3192",
      "orientation": "portrait"
    },
    "extra": {
      "eas": {
        "projectId": "9427d0a4-004d-4f04-8378-3f16a336dbaf"
      }
    },
    "plugins": [
      "expo-font",
      "expo-web-browser"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9427d0a4-004d-4f04-8378-3f16a336dbaf"
    }
  }
}
