{
  "name": "ebike-mobile",
  "version": "1.0.5",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web && node scripts/post-export.js",
    "export:web": "expo export --platform web && node scripts/post-export.js",
    "eas": "eas",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~55.0.32",
    "expo-constants": "~55.0.17",
    "expo-device": "~55.0.21",
    "expo-font": "~55.0.8",
    "expo-notifications": "~55.0.27",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "lucide-react-native": "^1.7.0",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.10",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "^25.3.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
