// ============================================================
// DandoEv — Prisma Schema (PostgreSQL)
// ============================================================

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ---- Enums ----

enum UserRole {
  customer
  guarantor
  super_admin
  finance_admin
  compliance_officer
  operations_admin
}

enum CustomerStatus {
  guest
  registered
  bnpl_applicant
  active_bnpl
  defaulted
  suspended
}

enum KycStatus {
  pending
  verified
  failed
  expired
}

enum BikeAvailability {
  in_stock
  out_of_stock
  pre_order
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  card
  bank_transfer
  wallet
  bnpl
}

enum LoanStatus {
  pending
  under_review
  approved
  rejected
  active
  completed
  defaulted
}

enum RepaymentStatus {
  upcoming
  paid
  overdue
  failed
  partial
}

enum GuarantorStatus {
  invited
  registered
  accepted
  declined
}

enum DocumentType {
  national_id
  passport
  drivers_license
  bvn_slip
  utility_bill
  bank_statement
  selfie
  signature
  work_id
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum TransactionStatus {
  initiated
  pending
  success
  failed
  reversed
}

enum WebhookEventStatus {
  received
  processing
  processed
  failed
}

enum DailySavingStatus {
  pending
  collected
  missed
}

// ---- Models ----

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  phone             String?        @unique
  firstName         String
  lastName          String
  passwordHash      String
  role              UserRole       @default(customer)
  customerStatus    CustomerStatus @default(registered)
  kycStatus         KycStatus      @default(pending)
  dateOfBirth       DateTime?
  address           String?
  city              String?
  state             String?
  employmentStatus  String?
  monthlyIncome     Decimal?       @db.Decimal(15, 2)
  employerName      String?
  employerAddress   String?
  bvn               String?        // encrypted at app level
  ninNumber         String?        // encrypted at app level
  bankName          String?
  bankAccountNumber String?        // encrypted at app level
  bankAccountName   String?
  profileImageUrl   String?
  isEmailVerified   Boolean        @default(false)
  isPhoneVerified   Boolean        @default(false)
  twoFactorEnabled  Boolean        @default(false)
  twoFactorSecret   String?
  // ---- Mono Integration ----
  monoAccountId     String?        // Mono account ID after Connect
  monoStatus        String?        // 'linked', 'statement_fetched', 'failed'
  monoMandateId     String?        // Active Mono Recurring Direct Debit Mandate ID
  monoMandateStatus String?        // 'pending', 'approved', 'active', 'paused', 'cancelled'
  monoBankCode      String?        // CBN / NIP 3-6 digit bank code
  // ---- Paystack Integration ----
  paystackCustomerCode String?     // Paystack customer code
  paystackAuthCode  String?        // Saved authorization_code for recurring charges
  pushToken         String?        // FCM/Expo push token
  pushPlatform      String?        // 'expo', 'fcm', 'apns'
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  lastLoginAt       DateTime?

  // Relations
  loans             Loan[]
  orders            Order[]
  kycDocuments      KycDocument[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  repayments        Repayment[]
  transactions      PaymentTransaction[]
  dailySavings      DailySaving[]
  idempotencyKeys   IdempotencyKey[]
  guarantorsCreated Guarantor[]    @relation("ApplicantGuarantors")
  wallet            Wallet?
  guarantorAccount  Guarantor?    @relation("GuarantorUser")
  monoAssessments   MonoFinancialAssessment[]

  @@index([email])
  @@index([role])
  @@index([customerStatus])
  @@index([kycStatus])
  @@map("users")
}

model Bike {
  id                 String           @id @default(uuid())
  name               String
  brand              String
  model              String?
  description        String?
  price              Decimal          @db.Decimal(15, 2)
  images             String[]
  category           String?
  motorPower         Int?             // watts
  batteryCapacity    Int?             // Wh
  rangeKm            Int?
  topSpeed           Int?             // km/h
  weight             Decimal?         @db.Decimal(5, 1)
  chargingTime       Decimal?         @db.Decimal(3, 1) // hours
  warranty           String?
  colors             String[]
  availability       BikeAvailability @default(in_stock)
  bnplEligible       Boolean          @default(true)
  bnplMinDownPayment Int              @default(0) // percentage
  stockQuantity      Int              @default(0)
  rating             Decimal?         @db.Decimal(2, 1)
  reviewCount        Int              @default(0)
  features           String[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  orders Order[]
  loans  Loan[]

  @@map("bikes")
}

model Order {
  id             String        @id @default(uuid())
  userId         String
  bikeId         String?
  quantity       Int           @default(1)
  unitPrice      Decimal       @db.Decimal(15, 2)
  totalAmount    Decimal       @db.Decimal(15, 2)
  paymentMethod  PaymentMethod
  status         OrderStatus   @default(pending)
  deliveryType   String?       @default("pickup")
  deliveryFee    Decimal?      @default(0) @db.Decimal(15, 2)
  insuranceFee   Decimal?      @default(0) @db.Decimal(15, 2)
  serviceFee     Decimal?      @default(0) @db.Decimal(15, 2)
  deliveryAddress String?
  deliveryCity   String?
  deliveryState  String?
  deliveryPhone  String?
  trackingNumber String?
  loanId         String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  user         User               @relation(fields: [userId], references: [id])
  bike         Bike?              @relation(fields: [bikeId], references: [id])
  loan         Loan?              @relation(fields: [loanId], references: [id])
  transactions PaymentTransaction[]
  accessories  OrderAccessory[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model Loan {
  id                 String     @id @default(uuid())
  userId             String
  bikeId             String
  downPayment        Decimal?   @db.Decimal(15, 2)
  loanAmount         Decimal    @db.Decimal(15, 2)
  interestRate       Decimal    @db.Decimal(5, 2)
  serviceFee         Decimal?   @default(20000) @db.Decimal(15, 2)
  insuranceFee       Decimal?   @default(25000) @db.Decimal(15, 2)
  deliveryType       String?    @default("pickup")
  deliveryFee        Decimal?   @default(0) @db.Decimal(15, 2)
  deductionFrequency String     @default("bidaily")
  tenure             Int        // months
  monthlyRepayment   Decimal    @db.Decimal(15, 2)
  totalRepayable     Decimal    @db.Decimal(15, 2)
  status             LoanStatus @default(pending)
  riskScore          Int?
  kycVerified        Boolean    @default(false)
  guarantorsVerified Boolean    @default(false)
  agreementAcceptedAt DateTime?
  agreementVersion    String?
  agreementIpAddress  String?
  agreementUserAgent  String?
  // ---- Mono Mandate & Auto-Deduction ----
  monoAccountId      String?
  monoMandateId      String?
  monoMandateRef     String?
  monoMandateStatus  String?    @default("pending") // pending, approved, active, paused, completed, cancelled
  mandateStartDate   DateTime?
  mandateEndDate     DateTime?
  adminNotes         String?
  rejectionReason    String?
  bikeSerialNumber   String?
  chassisNumber      String?
  batteryNumber1     String?
  batteryNumber2     String?
  chargerNumber      String?
  deliveryAddress    String?
  deliveryCity       String?
  deliveryState      String?
  approvedBy         String?
  approvedAt         DateTime?
  disbursedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  user         User               @relation(fields: [userId], references: [id])
  bike         Bike               @relation(fields: [bikeId], references: [id])
  repayments   Repayment[]
  guarantors   Guarantor[]
  orders       Order[]
  transactions PaymentTransaction[]
  dailySavings DailySaving[]
  documents    KycDocument[]
  recoveryCase RecoveryCase?
  monoAssessment MonoFinancialAssessment?

  @@index([userId])
  @@index([status])
  @@map("loans")
}

model MonoFinancialAssessment {
  id                         String   @id @default(uuid())
  userId                     String   @unique
  loanId                     String?  @unique
  provider                   String   @default("mono")
  monoAccountId              String?
  verifiedMonthlyInflow      Decimal  @db.Decimal(15, 2)
  verifiedMonthlyOutflow     Decimal  @db.Decimal(15, 2)
  netMonthlyCashflow         Decimal  @db.Decimal(15, 2)
  existingMonthlyDebt        Decimal  @db.Decimal(15, 2)
  maxAffordableInstallment   Decimal  @db.Decimal(15, 2)
  dtiRatioPercent            Decimal  @db.Decimal(6, 2)
  creditScore                Int
  riskTier                   String
  underwritingDecision       String
  detectedLenders            Json
  decisionReasons            Json
  statementMonthsAnalysed    Int
  statementPeriodStart       String?
  statementPeriodEnd         String?
  totalCredits               Decimal  @db.Decimal(15, 2)
  totalDebits                Decimal  @db.Decimal(15, 2)
  source                     String   @default("mono")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  loan Loan? @relation(fields: [loanId], references: [id])

  @@index([underwritingDecision])
  @@index([createdAt])
  @@map("mono_financial_assessments")
}

model Repayment {
  id                String          @id @default(uuid())
  loanId            String
  userId            String
  installmentNumber Int
  amount            Decimal         @db.Decimal(15, 2)
  amountPaid        Decimal         @default(0) @db.Decimal(15, 2)
  dueDate           DateTime
  paidDate          DateTime?
  status            RepaymentStatus @default(upcoming)
  lateFee           Decimal         @default(0) @db.Decimal(15, 2)
  paymentReference  String?
  retryCount        Int             @default(0)
  createdAt         DateTime        @default(now())

  // Relations
  loan User       @relation(fields: [userId], references: [id])
  loanRelation     Loan @relation(fields: [loanId], references: [id])

  @@index([loanId])
  @@index([userId])
  @@index([dueDate])
  @@index([status])
  @@map("repayments")
}

model Guarantor {
  id              String          @id @default(uuid())
  loanId          String
  applicantUserId String
  userId          String?         @unique // Link to their own User account if they have one
  fullName        String
  email           String?
  phone           String?
  relationship    String?
  status          GuarantorStatus @default(invited)
  idDocumentUrl   String?
  signatureUrl    String?
  acceptedAt      DateTime?
  monoAccountId   String?
  verifiedAt      DateTime?
  agreementAcceptedAt DateTime?
  inviteTokenHash String?         @unique
  inviteExpiresAt DateTime?
  createdAt       DateTime        @default(now())

  // Relations
  loan      Loan @relation(fields: [loanId], references: [id])
  applicant User @relation("ApplicantGuarantors", fields: [applicantUserId], references: [id])
  user      User? @relation("GuarantorUser", fields: [userId], references: [id])

  @@map("guarantors")
}

model RecoveryCase {
  id             String           @id @default(uuid())
  loanId         String           @unique
  status         RecoveryStatus   @default(active)
  stage          RecoveryStage    @default(initial_notice)
  totalAtRisk    Decimal          @db.Decimal(15, 2)
  assignedOfficer String?
  openedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  closedAt       DateTime?
  resolution     String?          // settled, legal_action, written_off

  // Relations
  loan           Loan             @relation(fields: [loanId], references: [id])
  activities     RecoveryActivity[]

  @@map("recovery_cases")
}

model RecoveryActivity {
  id             String           @id @default(uuid())
  caseId         String
  action         String           // call, email, sms, demand_letter, site_visit
  actorId        String?          // admin who performed the action
  notes          String?
  metadata       Json?            // results, external refs
  createdAt      DateTime         @default(now())

  // Relations
  recoveryCase   RecoveryCase     @relation(fields: [caseId], references: [id])

  @@map("recovery_activities")
}

enum RecoveryStatus {
  active
  on_hold
  settled
  closed
}

enum RecoveryStage {
  initial_notice
  final_warning
  guarantor_escalation
  demand_letter
  legal_action
  written_off
}

model KycDocument {
  id                 String             @id @default(uuid())
  userId             String
  loanId             String?
  type               DocumentType
  fileUrl            String
  fileName           String?
  provider           String?
  verificationStatus VerificationStatus @default(pending)
  verifiedBy         String?
  verifiedAt         DateTime?
  uploadedAt         DateTime           @default(now())

  // Relations
  user User  @relation(fields: [userId], references: [id])
  loan Loan? @relation(fields: [loanId], references: [id])

  @@map("kyc_documents")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  resource   String?
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // payment_reminder, loan_approved, etc.
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

// ---- New Infrastructure Tables ----

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  revokedAt DateTime?
  familyId  String   // for reuse detection
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String   @unique
  userId       String
  endpoint     String
  responseCode Int
  responseBody Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model WebhookEvent {
  id           String             @id @default(uuid())
  provider     String             // paystack, flutterwave
  eventType    String
  eventId      String             @unique // provider's event ID for dedup
  payload      Json
  status       WebhookEventStatus @default(received)
  retryCount   Int                @default(0)
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime           @default(now())

  @@index([eventId])
  @@index([status])
  @@map("webhook_events")
}

model PaymentTransaction {
  id             String            @id @default(uuid())
  userId         String
  orderId        String?
  loanId         String?
  repaymentId    String?
  provider       String            // paystack
  providerRef    String?           // paystack transaction reference
  amount         Decimal           @db.Decimal(15, 2)
  currency       String            @default("NGN")
  status         TransactionStatus @default(initiated)
  idempotencyKey String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  reconciledAt   DateTime?

  // Relations
  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
  loan  Loan?  @relation(fields: [loanId], references: [id])

  @@index([userId])
  @@index([providerRef])
  @@index([status])
  @@map("payment_transactions")
}

model DailySaving {
  id         String           @id @default(uuid())
  userId     String
  loanId     String
  date       DateTime         @db.Date
  amount     Decimal          @default(1000) @db.Decimal(15, 2)
  status     DailySavingStatus @default(pending)
  paymentRef String?
  createdAt  DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])
  loan Loan @relation(fields: [loanId], references: [id])

  @@unique([userId, loanId, date])
  @@index([userId])
  @@index([loanId])
  @@map("daily_savings")
}

// ---- Ledger & Wallet ----

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  mainBalance  Decimal  @default(0) @db.Decimal(15, 2)
  lockedSaving Decimal  @default(0) @db.Decimal(15, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model LedgerEntry {
  id        String   @id @default(uuid())
  groupId   String   // joins debit & credit events
  account   String   // 'wallet_main', 'wallet_locked', 'platform_revenue', etc.
  debit     Decimal  @default(0) @db.Decimal(15, 2)
  credit    Decimal  @default(0) @db.Decimal(15, 2)
  reference String   // txId, repaymentId, etc.
  details   String?
  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([account])
  @@map("ledger_entries")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique // 'savings_percentage', 'max_loan_limit', etc.
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

model Settlement {
  id             String   @id @default(uuid())
  provider       String   // paystack, mono
  providerRef    String   @unique // Provider's payout ID
  amount         Decimal  @db.Decimal(15, 2)
  currency       String   @default("NGN")
  status         String   // pending, successful, failed
  payoutDate     DateTime
  processedAt    DateTime?
  transactionIds String[] // IDs of transactions included in this settlement
  createdAt      DateTime @default(now())

  @@map("settlements")
}

model ReconciliationLog {
  id             String   @id @default(uuid())
  jobId          String
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  status         String   // processing, completed, failed
  totalProcessed Int      @default(0)
  totalMatched   Int      @default(0)
  totalFlagged   Int      @default(0)
  details        Json?    // Summary of discrepancies
  errors         String?
  
  @@map("reconciliation_logs")
}

model Accessory {
  id            String   @id @default(uuid())
  name          String
  description   String?
  price         Decimal  @db.Decimal(15, 2)
  images        String[]
  category      String   // 'battery', 'charger'
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderAccessories OrderAccessory[]

  @@map("accessories")
}

model OrderAccessory {
  id          String   @id @default(uuid())
  orderId     String
  accessoryId String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(15, 2)

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  accessory   Accessory @relation(fields: [accessoryId], references: [id])

  @@map("order_accessories")
}
